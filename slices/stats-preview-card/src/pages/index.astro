---
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/default-layout.astro";
import headerImage from "../assets/images/image-header-mobile.jpg";

const stats = [
  { count: "10k+", label: "COMPANIES" },
  { count: "314", label: "TEMPLATES" },
  { count: "12M+", label: "QUERIES" },
];
---

<DefaultLayout>
  <div
    class="bg-card-bg flex w-full max-w-[328px] flex-col rounded-[10px] min-[1440px]:max-w-[1110px] min-[1440px]:flex-row-reverse"
  >
    <div
      class="relative before:absolute before:size-full before:rounded-t-[10px] before:bg-[hsla(277,64%,61%,0.9)] before:mix-blend-multiply before:content-[''] min-[1440px]:w-[49%] min-[1440px]:before:rounded-t-none min-[1440px]:before:rounded-r-[10px]"
    >
      <Image
        src={headerImage}
        alt=""
        layout="constrained"
        height={240}
        width={328}
        class="w-full rounded-t-[10px] object-cover object-top min-[1440px]:h-full min-[1440px]:rounded-t-none min-[1440px]:rounded-r-[10px]"
      />
    </div>
    <div
      class="px-8 pt-10.5 pb-9 text-center min-[1440px]:w-[51.5%] min-[1440px]:p-18 min-[1440px]:pb-16 min-[1440px]:text-left"
    >
      <h1
        class="text-[28px] leading-[32px] font-bold text-white min-[1440px]:text-4xl min-[1440px]:leading-[44px]"
      >
        Get <span class="text-accent">insights</span> that help your business grow.
      </h1>
      <p
        class="mt-4.5 text-[15px] leading-[24px] text-white/75 min-[1440px]:mt-6 min-[1440px]:max-w-[380px]"
      >
        Discover the benefits of data analytics and make better decisions regarding revenue,
        customer experience, and overall efficiency.
      </p>
      <div
        class="mt-10 flex flex-col gap-6.5 min-[1440px]:mt-18 min-[1440px]:flex-row min-[1440px]:gap-15"
      >
        {
          stats.map(stat => (
            <div class="flex flex-col gap-1.5">
              <p class="text-2xl font-bold text-white">{stat.count}</p>
              <h2 class="font-deca text-xs tracking-widest text-white/60">{stat.label}</h2>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</DefaultLayout>
