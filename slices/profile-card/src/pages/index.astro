---
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/default-layout.astro";
import patternImage from "../assets/images/bg-pattern-card.svg";
import avatarImage from "../assets/images/image-victor.jpg";

const stats = [
  {
    count: "80K",
    label: "Followers",
  },
  {
    count: "803K",
    label: "Likes",
  },
  {
    count: "1.4K",
    label: "Photos",
  },
];
---

<DefaultLayout>
  <div class="rounded-2xl bg-white shadow-2xl">
    <Image src={patternImage} alt="" height={140} class="h-[140px] rounded-t-2xl object-cover" />
    <div class="-mt-13 flex flex-col items-center">
      <figure class="rounded-full border-6 border-white">
        <Image src={avatarImage} alt="Avatar picture of Victor" class="rounded-full" />
      </figure>
      <h1 class="text-navy-950 mt-4 text-lg font-bold">
        Victor Crest
        <span class="font-normal text-gray-500">26</span>
      </h1>
      <p class="text-sm text-gray-500">London</p>
    </div>
    <div
      class="mt-7 flex items-center justify-around border-t border-gray-100 px-6 pt-5 pb-6 min-[1440px]:mt-6"
    >
      {
        stats.map(stat => (
          <div class="flex flex-col items-center">
            <p class="text-navy-950 text-lg font-bold">{stat.count}</p>
            <p class="text-[10px] tracking-[2px] text-gray-500">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</DefaultLayout>
