---
import DefaultLayout from "../layouts/default-layout.astro";
import StarIcon from "../assets/images/icon-star.svg";
import thanksIllustration from "../assets/images/illustration-thank-you.svg";
---

<DefaultLayout>
  <div
    class="w-full max-w-[328px] rounded-2xl bg-linear-[in_oklab,var(--color-gray-900)_0%,#171E28_100%] p-6 pb-8 text-white min-[1440px]:max-w-[412px] min-[1440px]:rounded-[30px] min-[1440px]:p-8"
  >
    <form id="rating-form" class="flex flex-col">
      <div
        class="flex size-10 items-center justify-center rounded-full bg-gray-500/10 min-[1440px]:size-12"
      >
        <StarIcon class="shrink-0" />
      </div>
      <h1 class="mt-[21px] text-2xl font-bold min-[1440px]:mt-[35px] min-[1440px]:text-[28px]">
        How did we do?
      </h1>
      <p
        class="mt-3 text-[14px] text-gray-500 min-[1440px]:mt-2.5 min-[1440px]:text-[15px] min-[1440px]:leading-[23px]"
      >
        Please let us know how we did with your support request. All feedback is appreciated to help
        us improve our offering!
      </p>
      <div class="mt-[26px] flex items-center justify-between">
        {
          [...Array(5)].keys().map(i => (
            <div class="flex items-center justify-center">
              <label class="sr-only" for={`rating-${i + 1}`}>
                Give {i + 1} of 5 rating
              </label>
              <input
                type="radio"
                value={i + 1}
                id={`rating-${i + 1}`}
                name="rating"
                class="checked:bg-orange relative cursor-pointer appearance-none rounded-full bg-gray-900 p-5 text-sm font-bold text-gray-500 transition-colors before:absolute before:top-1/2 before:left-1/2 before:-translate-1/2 before:content-[attr(value)] checked:text-gray-950 hover:text-gray-950 hover:not-checked:bg-white min-[1440px]:p-6 min-[1440px]:text-base"
              />
            </div>
          ))
        }
      </div>
      <button
        type="submit"
        class="bg-orange mt-[25px] flex cursor-pointer items-center justify-center rounded-full p-[15.6px] text-[14px] leading-[14px] font-bold tracking-[2px] text-gray-950 uppercase transition-colors hover:bg-white min-[1440px]:mt-8 min-[1440px]:text-[15px] min-[1440px]:leading-[15px]"
      >
        SUBMIT
      </button>
    </form>

    <div
      id="rating-thanks"
      class="flex hidden flex-col items-center pt-2.5 pb-1 text-center min-[1440px]:pt-3 min-[1440px]:pb-4"
    >
      <img
        src={thanksIllustration.src}
        alt=""
        class="w-[144px] min-[1440px]:w-[162px]"
        width={144}
      />
      <span
        id="rating-result"
        class="text-orange mt-6 flex h-8 items-center justify-center rounded-full bg-gray-500/10 p-1 px-2 px-3 text-center text-[14px] min-[1440px]:mt-8 min-[1440px]:px-5"
      >
        <!-- You selected 4 out of 5 -->
      </span>
      <h1 class="mt-[29px] text-2xl font-bold min-[1440px]:mt-[39px] min-[1440px]:text-[28px]">
        Thank you!
      </h1>
      <p
        class="mt-3 text-[14px] leading-[22px] text-gray-500 min-[1440px]:mt-2.5 min-[1440px]:text-[15px]"
      >
        We appreaciate you taking the time to give a rating. If you ever need more support, don't
        hesitate to get in touch!
      </p>
    </div>
  </div>
</DefaultLayout>

<script>
  const ratingForm = document.getElementById("rating-form") as HTMLFormElement;
  const ratingThanks = document.getElementById("rating-thanks") as HTMLDivElement;
  const ratingResult = document.getElementById("rating-result") as HTMLSpanElement;

  ratingForm.addEventListener("submit", event => {
    event.preventDefault();

    const data = new FormData(ratingForm);

    if (!data.has("rating")) {
      alert("Choose your rating!");
      return;
    }

    ratingResult.innerText = `You selected ${data.get("rating")} out of 5`;
    ratingThanks.classList.toggle("hidden");
    ratingForm.classList.toggle("hidden");
  });
</script>
