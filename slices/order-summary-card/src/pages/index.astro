---
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/default-layout.astro";
import thumbnailImage from "../assets/images/illustration-hero.svg";
import MusicIcon from "../assets/images/icon-music.svg";
---

<DefaultLayout>
  <div
    class="flex w-full max-w-[320px] flex-col rounded-2xl bg-white shadow-2xl shadow-blue-700/15 min-[1440px]:max-w-[450px]"
  >
    <div class="group relative rounded-lg">
      <Image
        src={thumbnailImage}
        alt=""
        height={280}
        width={280}
        class="size-full rounded-t-2xl object-cover"
      />
    </div>

    <div
      class="flex flex-col justify-center px-6 pt-8 pb-6 text-center min-[1440px]:px-12 min-[1440px]:pt-10 min-[1440px]:pb-8"
    >
      <div class="flex flex-col gap-4">
        <h1 class="text-[22px] font-black text-blue-950 min-[1440px]:text-[28px]">Order Summary</h1>
        <p class="mx-auto max-w-[260px] font-medium text-blue-950/75 min-[1440px]:max-w-none">
          You can now listen to millions of songs, audiobooks, and podcasts on any device anywhere
          you like!
        </p>
      </div>
      <div
        class="mt-6.5 flex items-center rounded-xl bg-blue-50 p-4 text-sm min-[1440px]:p-6 min-[1440px]:text-base"
      >
        <MusicIcon />
        <div class="ml-4">
          <p class="font-black">Annual Plan</p>
          <span class="font-bold text-blue-950/65">$59.99/year</span>
        </div>
        <a href="#" class="ml-auto text-xs font-black text-blue-700 underline">Change</a>
      </div>
      <div class="mt-6.5 flex flex-col gap-4 min-[1440px]:mt-8">
        <button
          class="flex h-12.5 w-full items-center justify-center rounded-xl border border-blue-700 bg-blue-700 px-6 py-2 text-sm font-black text-white shadow-xl shadow-blue-700/25"
        >
          Proceed to Payment
        </button>
        <button
          class="flex w-full items-center justify-center py-2 text-sm font-black text-blue-950/65 min-[1440px]:py-4"
        >
          Cancel Order
        </button>
      </div>
    </div>
  </div>
</DefaultLayout>
