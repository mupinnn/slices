---
import DefaultLayout from "../layouts/default-layout.astro";
import imageHeroMobile from "../assets/images/image-hero-mobile.jpg";
import imageHeroDesktop from "../assets/images/image-hero-desktop.jpg";
import MastercraftLogo from "../assets/images/logo-mastercraft.svg";
import BookmarkIcon from "../assets/images/icon-bookmark.svg";
import BookmarkedIcon from "../assets/images/icon-bookmarked.svg";
import CloseIcon from "../assets/images/icon-close-modal.svg";
import CheckIcon from "../assets/images/icon-check.svg";
import Button from "../components/ui/button.astro";

const stats = [
  {
    title: "$89,914",
    subtitle: "of $100,000 backed",
  },
  {
    title: "5,007",
    subtitle: "total backers",
  },
  {
    title: 56,
    subtitle: "days left",
  },
];

const rewards = [
  {
    title: "Bamboo Stand",
    pledge: 25,
    description:
      "You get an ergonomic stand made of natural bamboo. You've helped us launch our promotional campaign, and you'll be added to a special Backer member list.",
    stock: 101,
  },
  {
    title: "Black Edition Stand",
    pledge: 75,
    description:
      "You get a Black Special Edition computer stand and a personal thank you. You'll be added to our Back member list. Shipping is included.",
    stock: 64,
  },
  {
    title: "Mahogany Special Edition",
    pledge: 200,
    description:
      "You get two Special Edition Mahogany stands, a Backer T-Shirt, and a personal thank you. You'll be added to our Backed member list. Shipping is included.",
    stock: 0,
  },
];

const pledges = [
  {
    title: "Pledge with no reward",
    description:
      "Choose to support us without a reward if you simply believe in our project. As a backer, you will be signed up to receive product updates via email.",
  },
  ...rewards,
];
---

<DefaultLayout>
  <main class="flex w-full grow flex-col">
    <section class="relative">
      <div class="absolute size-full bg-linear-to-b from-black/60 to-transparent to-50%"></div>
      <img src={imageHeroDesktop.src} alt="" />
    </section>

    <section class="z-10 mx-auto -mt-14 max-w-[760px] space-y-6 px-5 min-[1440px]:-mt-22.5">
      <section
        class="flex flex-col items-center justify-center rounded-lg border border-gray-500/25 bg-white p-6 pb-9 text-center min-[1440px]:px-10.5 min-[1440px]:pb-11.5"
      >
        <MastercraftLogo class="-mt-12 min-[1440px]:-mt-13.5" />
        <h1
          class="mt-4.5 max-w-60 text-xl leading-6 font-bold min-[1440px]:mt-7.5 min-[1440px]:max-w-fit min-[1440px]:text-[28px]"
        >
          Mastercraft Bamboo Monitor Riser
        </h1>
        <p
          class="mt-3.5 text-sm leading-6 text-gray-500 min-[1440px]:mt-[19px] min-[1440px]:text-[16px]"
        >
          A beautifully handcrafted monitor stand to reduce neck and eye strain.
        </p>
        <div
          class="mt-5 flex w-full items-center gap-2 min-[1440px]:mt-9 min-[1440px]:justify-between"
        >
          <Button class="grow min-[1440px]:grow-0" data-project-dialog-trigger
            >Back this project</Button
          >
          <button
            id="btn-bookmark"
            data-bookmarked="false"
            class="group flex items-center gap-4 rounded-full font-bold min-[1440px]:bg-gray-500/10 min-[1440px]:pr-6"
          >
            <BookmarkIcon class="hidden group-data-[bookmarked=false]:block" />
            <BookmarkedIcon class="hidden group-data-[bookmarked=true]:block" />
            <p class="hidden text-gray-500 min-[1440px]:block">Bookmark</p>
          </button>
        </div>
      </section>

      <section
        class="flex flex-col rounded-lg border border-gray-500/25 bg-white px-6 pt-8 pb-[37px] min-[1440px]:px-10.5 min-[1440px]:pt-12.5 min-[1440px]:pb-11.5"
      >
        <div
          class="flex flex-col gap-12 text-center min-[1440px]:flex-row min-[1440px]:gap-24.5 min-[1440px]:text-left"
        >
          {
            stats.map(stat => (
              <div class="group relative flex flex-col gap-2">
                <p class="text-[30px] leading-8.5 font-bold">{stat.title}</p>
                <p class="text-sm text-gray-500">{stat.subtitle}</p>
                <div class="absolute -bottom-6 left-1/2 hidden h-[1px] w-4/12 -translate-x-1/2 bg-gray-500/25 group-not-last:block min-[1440px]:-right-12 min-[1440px]:bottom-auto min-[1440px]:left-auto min-[1440px]:h-full min-[1440px]:w-[1px] min-[1440px]:transform-none" />
              </div>
            ))
          }
        </div>

        <div
          aria-valuemax="100"
          aria-valuemin="0"
          role="progressbar"
          22px
          data-state="indeterminate"
          data-max="100"
          data-slot="progress"
          class="relative mt-[29px] flex h-3 w-full items-center overflow-x-hidden rounded-full bg-gray-500/15 min-[1440px]:mt-9"
        >
          <div
            data-state="indeterminate"
            data-max="100"
            data-slot="progress-indicator"
            class="size-full flex-1 rounded-full bg-green-400 transition-all"
            style="transform: translateX(-22%);"
          >
          </div>
        </div>
      </section>

      <section
        class="flex flex-col rounded-lg border border-gray-500/15 px-6 pt-8 pb-[37px] min-[1440px]:px-10.5 min-[1440px]:pt-12.5 min-[1440px]:pb-11.5"
      >
        <h2
          class="text-[18px] leading-[29px] font-bold min-[1440px]:text-[20px] min-[1440px]:leading-[18px]"
        >
          About this project
        </h2>
        <p
          class="mt-5.5 text-sm leading-5.5 text-gray-500 min-[1440px]:mt-10 min-[1440px]:text-[16px] min-[1440px]:leading-[28px]"
        >
          The Mastercraft Bamboo Monitor Riser is a sturdy and stylish platform that elevates your
          screen to a more comfortable viewing height. Placing your monitor at eye level has the
          potential to improve your posture and make you more comfortable while at work, helping you
          stay focused on the task at hand.
        </p>
        <p
          class="mt-7.5 text-sm leading-5.5 text-gray-500 min-[1440px]:mt-10 min-[1440px]:text-[16px] min-[1440px]:leading-[28px]"
        >
          Featuring artisan craftmanship, the simplicity of design creates extra desk space below
          your computer to allow notepads, pens, and USB sticks to be stored under the stand.
        </p>

        <div class="mt-9 space-y-6">
          {
            rewards.map(reward => (
              <div
                class="flex flex-col rounded-lg border border-gray-500/15 p-5 text-sm data-[out-of-stock=true]:opacity-50 min-[1440px]:px-7.5 min-[1440px]:py-9 min-[1440px]:pb-8 min-[1440px]:text-base"
                data-out-of-stock={reward.stock === 0}
              >
                <div class="flex flex-col gap-1 min-[1440px]:flex-row min-[1440px]:justify-between">
                  <h3 class="font-bold min-[1440px]:text-[18px] min-[1440px]:leading-[20px]">
                    {reward.title}
                  </h3>
                  <p class="font-medium text-green-400">Pledge ${reward.pledge} or more</p>
                </div>
                <p class="mt-6 leading-5.5 text-gray-500 min-[1440px]:mt-5 min-[1440px]:leading-7.5">
                  {reward.description}
                </p>
                <div class="mt-7 flex flex-col gap-6 min-[1440px]:mt-6 min-[1440px]:flex-row min-[1440px]:justify-between">
                  <div class="flex items-center gap-2">
                    <p class="text-3xl font-bold">{reward.stock}</p>
                    <p class="font-medium text-gray-500">left</p>
                  </div>
                  <Button
                    size="sm"
                    class="w-fit"
                    disabled={reward.stock === 0}
                    data-project-dialog-trigger
                  >
                    {reward.stock > 0 ? "Select Reward" : "Out of Stock"}
                  </Button>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </section>
  </main>

  <dialog
    id="choose-project-dialog"
    class="inset-x-6 top-[117px] mx-auto max-h-[calc(100%-234px)] w-[calc(100%-48px)] max-w-[720px] rounded-lg backdrop:bg-black/35"
  >
    <div class="bg-white p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-[18px] leading-[29px] font-bold">Back this project</h2>
        <button id="choose-project-dialog-close">
          <CloseIcon />
        </button>
      </div>
      <p class="mt-6 text-sm text-gray-500">
        Want to support us in bringing Mastercraft Bamboo Monitor Riser out in the world?
      </p>
      <div class="mt-6 space-y-6">
        {
          pledges.map(pledge => (
            <div
              class="flex flex-col rounded-lg border border-gray-500/15 p-5 text-sm has-checked:border-green-400 data-[out-of-stock=true]:opacity-50"
              data-out-of-stock={"stock" in pledge && pledge.stock === 0}
            >
              <div class="peer flex items-center justify-between">
                <label
                  for={pledge.title}
                  class="flex cursor-pointer items-center gap-4 transition-colors hover:text-green-400"
                >
                  <input
                    type="radio"
                    id={pledge.title}
                    value={pledge.title}
                    name="project"
                    class="box-content size-3 appearance-none rounded-full border-[5px] border-white bg-white bg-clip-padding ring-1 ring-gray-500/15 outline-none checked:bg-green-400"
                    disabled={"stock" in pledge && pledge.stock === 0}
                  />
                  <div class="flex flex-col gap-1 min-[1440px]:flex-row min-[1440px]:gap-4">
                    <h3 class="font-bold">{pledge.title}</h3>
                    {"pledge" in pledge && (
                      <p class="font-medium text-green-400">Pledge ${pledge.pledge} or more</p>
                    )}
                  </div>
                </label>
                {"stock" in pledge && (
                  <div class="hidden items-center gap-2 min-[1440px]:flex">
                    <p class="text-[18px] font-bold">{pledge.stock}</p>
                    <p class="font-medium text-gray-500">left</p>
                  </div>
                )}
              </div>
              <p class="mt-6 leading-5.5 text-gray-500">{pledge.description}</p>
              {"stock" in pledge && (
                <div class="mt-7 flex items-center gap-2 min-[1440px]:hidden">
                  <p class="font-bold">{pledge.stock}</p>
                  <p class="font-medium text-gray-500">left</p>
                </div>
              )}
              <div class="-mx-5 mt-7 hidden flex-col items-center justify-center gap-4 border-t border-gray-500/15 px-5 pt-8 peer-has-checked:flex min-[1440px]:flex-row min-[1440px]:justify-between min-[1440px]:pt-5">
                <p class="text-center text-gray-500">Enter your pledge</p>
                <div class="flex items-center gap-2">
                  <div class="flex h-11.5 items-center gap-1 rounded-full border border-gray-500/15 px-4 has-focus:border-green-400">
                    <span class="font-medium text-gray-500">$</span>
                    <input
                      type="text"
                      value={"pledge" in pledge ? pledge.pledge : 1}
                      class="w-10 font-bold"
                    />
                  </div>
                  <Button size="sm" data-confirm-trigger>
                    Continue
                  </Button>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </dialog>

  <dialog
    id="confirm-dialog"
    class="inset-x-6 top-[117px] mx-auto max-h-[calc(100%-234px)] w-[calc(100%-48px)] max-w-[450px] rounded-lg backdrop:bg-black/35"
  >
    <div class="flex flex-col items-center justify-center gap-5 bg-white p-6 text-center">
      <CheckIcon />
      <h2 class="text-[18px] leading-[29px] font-bold min-[1440px]:text-xl">
        Thanks for your support!
      </h2>
      <p class="text-sm text-gray-500 min-[1440px]:text-base">
        Your pledge brings us one step closer to sharing Mastercraft Bamboo Monitor Riser worldwide.
        You will get an email once our campaign is completed.
      </p>
      <Button size="sm" id="confirm-dialog-close">Got it!</Button>
    </div>
  </dialog>
</DefaultLayout>

<script>
  const projectDialog = document.getElementById("choose-project-dialog") as HTMLDialogElement;
  const projectDialogCloseButton = document.getElementById(
    "choose-project-dialog-close"
  ) as HTMLButtonElement;
  const projectDialogTrigger = document.querySelectorAll("[data-project-dialog-trigger]");
  const confirmDialog = document.getElementById("confirm-dialog") as HTMLDialogElement;
  const confirmDialogCloseButton = document.getElementById(
    "confirm-dialog-close"
  ) as HTMLButtonElement;
  const confirmDialogTrigger = document.querySelectorAll("[data-confirm-trigger]");
  const bookmarkButton = document.getElementById("btn-bookmark") as HTMLButtonElement;

  projectDialogTrigger.forEach(trigger => {
    trigger.addEventListener("click", () => {
      document.body.classList.add("overflow-hidden");
      projectDialog.showModal();
    });
  });

  projectDialogCloseButton.addEventListener("click", () => {
    document.body.classList.remove("overflow-hidden");
    projectDialog.close();
  });

  confirmDialogTrigger.forEach(trigger => {
    trigger.addEventListener("click", () => {
      projectDialog.close();
      confirmDialog.showModal();
    });
  });

  confirmDialogCloseButton.addEventListener("click", () => {
    document.body.classList.remove("overflow-hidden");
    confirmDialog.close();
  });

  bookmarkButton.addEventListener("click", () => {
    bookmarkButton.dataset.bookmarked =
      bookmarkButton.dataset.bookmarked === "true" ? "false" : "true";

    const text = bookmarkButton.querySelector("p") as HTMLParagraphElement;

    if (bookmarkButton.dataset.bookmarked === "true") {
      text.innerText = "Bookmarked";
    } else {
      text.innerText = "Bookmark";
    }
  });
</script>
