---
import Logo from "../assets/images/logo.svg";
import HamburgerIcon from "../assets/images/icon-hamburger.svg";
import XIcon from "../assets/images/icon-close-menu.svg";

const menu = ["About", "Discover", "Get Started"];
---

<nav
  class="fixed inset-x-0 z-50 flex items-center justify-between gap-2 bg-transparent px-5 py-7.5 min-[1440px]:px-[162px] min-[1440px]:py-[47px]"
>
  <Logo />

  <button class="group min-[1440px]:hidden" data-open="false" id="btn-menu">
    <HamburgerIcon class="hidden group-data-[open=false]:block" />
    <XIcon class="hidden group-data-[open=true]:block" />
  </button>

  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-20 hidden h-svh w-full bg-linear-to-b from-transparent to-black/35 to-10% px-5 min-[1440px]:static min-[1440px]:block min-[1440px]:size-auto min-[1440px]:bg-none min-[1440px]:p-0"
  >
    <div
      class="flex flex-col divide-y divide-gray-500/25 rounded-lg bg-white font-medium min-[1440px]:flex-row min-[1440px]:items-center min-[1440px]:gap-7.5 min-[1440px]:divide-none min-[1440px]:bg-transparent min-[1440px]:text-white"
    >
      {
        menu.map(m => (
          <a href="#" class="p-5 min-[1440px]:p-0 min-[1440px]:text-[14px]">
            {m}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById("btn-menu") as HTMLButtonElement;
  const mobileMenu = document.getElementById("mobile-menu") as HTMLDivElement;

  menuButton.addEventListener("click", e => {
    const target = e.currentTarget as HTMLButtonElement;
    target.dataset.open = target.dataset.open === "true" ? "false" : "true";
    mobileMenu.classList.toggle("hidden");
    mobileMenu.classList.toggle("block");
  });
</script>
