---
import "@fontsource-variable/commissioner";
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Slicing Template</title>
  </head>
  <body class="flex min-h-svh flex-col">
    <Navbar />

    <slot />

    <footer
      class="mt-10 px-4 pb-4 text-center text-sm text-balance [&_a]:text-green-700 [&_a]:underline"
    >
      Challenge by <a
        href="https://www.frontendmentor.io?ref=challenge"
        target="_blank"
        rel="noopener noreferrer">Frontend Mentor</a
      >. Coded by <a
        href="https://www.frontendmentor.io/profile/mupinnn"
        target="_blank"
        rel="noopener noreferrer">@mupinnn</a
      >
    </footer>
  </body>
</html>
