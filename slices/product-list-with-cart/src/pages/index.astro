---
import DefaultLayout from "@/layouts/default-layout.astro";
import MenuCard from "@/components/menu-card.astro";
import menus from "@/assets/data.json";
import IllustrationEmpty from "@/assets/assets/images/illustration-empty-cart.svg";
---

<DefaultLayout>
  <main
    class="mx-auto grid max-w-[1440px] grid-cols-1 gap-4 p-6 sm:px-[112px] sm:py-[90px] lg:gap-8 xl:grid-cols-[1fr_383px]"
  >
    <section class="flex flex-col gap-8">
      <h1 class="text-[38px] leading-[44px] font-bold text-rose-900 sm:text-[40px]">Desserts</h1>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-y-[35px] lg:grid-cols-3">
        {menus.map(menu => <MenuCard {...menu} />)}
      </div>
    </section>

    <section
      class="flex h-fit flex-col gap-7 rounded-[10px] bg-white px-6 py-8.5 sm:gap-[35px] sm:pt-5 sm:pb-[38px]"
    >
      <h2 class="text-red text-[24px] font-bold">Your Cart (0)</h2>
      <div class="flex flex-col items-center justify-center gap-4 text-center">
        <IllustrationEmpty />
        <p class="text-sm font-semibold text-rose-500">Your added items will appear here</p>
      </div>
    </section>
  </main>
</DefaultLayout>
