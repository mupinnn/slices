---
import DefaultLayout from "../layouts/default-layout.astro";
import Button from "../components/ui/button.astro";
import imageWeb3 from "../assets/images/image-web-3-desktop.jpg";
import imagePc from "../assets/images/image-retro-pcs.jpg";
import imageTopLaptop from "../assets/images/image-top-laptops.jpg";
import imageGaming from "../assets/images/image-gaming-growth.jpg";

const news = [
  {
    title: "Hydrogen VS Electric Cars",
    excerpt: "Will hydrogen-fueled cars ever catch up to EVs?",
  },
  {
    title: "The Downsides of AI Artistry",
    excerpt: "What are the possible adverse effects of on-demand AI image generation?",
  },
  {
    title: "Is VC Funding Drying Up?",
    excerpt: "Private funding by VC firms is down 50% YOY. We take a look at what that means.",
  },
];

const topPicks = [
  {
    title: "Reviving Retro PCs",
    excerpt: "What happens when old PCs are given modern upgrades?",
    thumbnail: imagePc.src,
  },
  {
    title: "Top 10 Laptops of 2022",
    excerpt: "Our best picks for various needs and budgets.",
    thumbnail: imageTopLaptop.src,
  },
  {
    title: "The Growth of Gaming",
    excerpt: "How the pandemic has sparked fresh opportunities.",
    thumbnail: imageGaming.src,
  },
];
---

<DefaultLayout>
  <main class="mx-auto mt-7.5 max-w-[1098px] grow gap-16 lg:mt-[55px] lg:gap-8">
    <div class="grid grid-cols-1 gap-6" id="highlight">
      <img
        src={imageWeb3.src}
        alt=""
        class="aspect-[16/14.1] object-cover lg:aspect-auto lg:h-[300px]"
      />
      <h1 class="text-[40px] leading-[38px] font-extrabold lg:text-[66px] lg:leading-[60px]">
        The Bright Future of Web 3.0?
      </h1>
      <p class="text-dark-grayish-blue -mt-2 text-[14px] leading-[24px]">
        We dive into the next evolution of the web that claims to put the power of the platforms
        back into the hands of the people. But is it really fulfilling its promise?
      </p>
      <Button class="w-fit">READ MORE</Button>
    </div>

    <div class="bg-very-dark-blue p-5" id="news">
      <h2 class="text-soft-orange text-3xl leading-[44px] font-bold">New</h2>
      <div class="text-off-white divide-grayish-blue mt-6 flex flex-col divide-y">
        {
          news.map(n => (
            <div class="group cursor-pointer py-8 first:pt-0 last:pb-0">
              <h3 class="group-hover:text-soft-orange text-[20px] font-bold transition-colors">
                {n.title}
              </h3>
              <p class="text-grayish-blue mt-2 text-sm">{n.excerpt}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3" id="topPick">
      {
        topPicks.map((top, i) => (
          <div class="text-very-dark-blue group flex cursor-pointer items-center gap-6">
            <img src={top.thumbnail} alt="" class="w-[98px] object-cover" />
            <div class="flex flex-col gap-1">
              <p class="text-soft-red text-[30px] font-extrabold">0{i + 1}</p>
              <h3 class="group-hover:text-soft-red text-[16px] font-extrabold transition-colors">
                {top.title}
              </h3>
              <p class="text-dark-grayish-blue text-sm">{top.excerpt}</p>
            </div>
          </div>
        ))
      }
    </div>
  </main>
</DefaultLayout>

<style>
  main {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (width >= 64rem) {
    #highlight {
      grid-area: highlight;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: 1fr 1fr 90px 90px;
      grid-template-areas:
        "image image image image"
        "image image image image"
        "title title text text"
        "title title button button";
    }

    #highlight > img {
      grid-area: image;
    }

    #highlight > h1 {
      grid-area: title;
    }

    #highlight > p {
      grid-area: text;
    }

    #highlight > button {
      grid-area: button;
    }

    #news {
      grid-area: news;
    }

    #topPick {
      grid-area: topPick;
    }

    main {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: 330px 180px 130px;
      grid-template-areas:
        "highlight highlight news"
        "highlight highlight news"
        "topPick topPick topPick";
    }
  }
</style>
