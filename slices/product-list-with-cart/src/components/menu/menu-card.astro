---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { formatCurrency } from "@/utils";
import { type Menu } from "@/types";
import { MenuAddToCartButton } from "./menu-add-to-cart-button";

type Props = Menu;

const menu = Astro.props;
const { name, category, price, image } = menu;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "@/assets/assets/images/*{jpeg,jpg,png}"
);

const mobileImage = await getImage({
  src: images[image.mobile](),
  format: "webp",
  width: 328,
  height: 214,
});

const tabletImage = await getImage({
  src: images[image.tablet](),
  format: "webp",
  width: 400,
  height: 400,
});

const desktopImage = await getImage({
  src: images[image.desktop](),
  format: "webp",
  width: 400,
  height: 400,
});
---

<div class="flex flex-col">
  <picture class="relative">
    <source media="" srcset={desktopImage.src} />
    <source media="" srcset={tabletImage.src} />
    <img
      src={mobileImage.src}
      alt=""
      class="aspect-[16/10.4] w-full rounded-[10px] object-cover sm:aspect-[9/8.7]"
    />

    <MenuAddToCartButton
      {...menu}
      className="absolute -bottom-5.5 left-1/2 -translate-x-1/2"
      client:load
    />
  </picture>

  <div class="mt-[38px] flex flex-col gap-[9px] leading-none">
    <p class="text-[14px] text-rose-500">{category}</p>
    <p class="font-semibold text-rose-900">{name}</p>
    <p class="text-red font-semibold">{formatCurrency(price)}</p>
  </div>
</div>
