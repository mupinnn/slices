---
import DefaultLayout from "../layouts/default-layout.astro";
import illustrationFiveStars from "../assets/images/illustration-five-stars.webp";
import illustrationMultiplePlatform from "../assets/images/illustration-multiple-platforms.webp";
import illustrationConsistentSchedule from "../assets/images/illustration-consistent-schedule.webp";
import illustrationSchedulePosts from "../assets/images/illustration-schedule-posts.webp";
import illustrationGrowFollowers from "../assets/images/illustration-grow-followers.webp";
import illustrationAudienceGrowth from "../assets/images/illustration-audience-growth.webp";
import illustrationCreatePost from "../assets/images/illustration-create-post.webp";
import illustrationAiContent from "../assets/images/illustration-ai-content.webp";
---

<DefaultLayout>
  <main class="mx-auto grid w-full max-w-[360px] grid-cols-1 gap-7 px-4 py-7.5">
    <div
      class="flex flex-col items-center justify-center gap-[22px] rounded-xl bg-purple-500 p-10 text-white"
    >
      <h2 class="text-center text-[41px] font-medium text-balance">
        Social Media <span class="text-yellow-500">10x</span>
        <span class="italic">Faster</span> with AI
      </h2>
      <div class="flex flex-col items-center gap-2">
        <img src={illustrationFiveStars.src} alt="" class="w-3/4" />
        <p>Over 4,000 5-star reviews</p>
      </div>
    </div>

    <div class="flex flex-col gap-4 rounded-xl bg-white p-4">
      <img src={illustrationMultiplePlatform.src} alt="" />
      <h2 class="text-[24px] font-medium -tracking-[1px]">
        Manage multiple accounts and platforms.
      </h2>
    </div>

    <div class="flex h-[207px] flex-col overflow-clip rounded-xl bg-yellow-500 p-4 pb-0">
      <h2 class="text-[24px] font-medium -tracking-[1px]">
        Maintain a consistent posting schedule.
      </h2>
      <img
        src={illustrationConsistentSchedule.src}
        alt=""
        class="relative -bottom-[13px] w-[67%]"
      />
    </div>

    <div class="flex flex-col items-center gap-6 rounded-xl bg-purple-100 p-4 py-8 text-center">
      <h2 class="text-[24px] font-medium -tracking-[1px]">Schedule to social media.</h2>
      <img src={illustrationSchedulePosts.src} alt="" />
      <p>Optimize post timings to publish content at the perfect time for your audience.</p>
    </div>

    <div
      class="flex flex-col items-center gap-[41px] rounded-xl bg-purple-500 p-6 text-center text-white"
    >
      <img src={illustrationGrowFollowers.src} alt="" class="w-[78%]" />
      <h2 class="max-w-3/4 text-[32px] leading-[26px] font-medium -tracking-[1px]">
        Grow followers with non-stop content.
      </h2>
    </div>

    <div class="flex flex-col rounded-xl bg-white p-6">
      <h2 class="text-[44px] font-medium -tracking-[1px]">&gt;56%</h2>
      <p class="mt-3.5">faster audience growth</p>
      <img src={illustrationAudienceGrowth.src} alt="" class="mt-6 w-3/5" />
    </div>

    <div class="flex flex-col rounded-xl bg-yellow-100 p-7">
      <h2 class="text-[28px] leading-[28px] font-medium -tracking-[1px]">
        Create and schedule content <span class="text-purple-500 italic">quicker.</span>
      </h2>
      <img src={illustrationCreatePost.src} alt="" class="mt-[25px] w-[68%]" />
    </div>

    <div class="flex flex-col rounded-xl bg-yellow-500 p-6">
      <h2 class="text-[28px] leading-[28px] font-medium -tracking-[1px]">
        Write your content using AI.
      </h2>
      <img src={illustrationAiContent.src} alt="" class="mt-6 w-3/4" />
    </div>
  </main>
</DefaultLayout>
