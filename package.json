{
  "name": "slices",
  "version": "1.0.0",
  "description": "A frontend development slicing playground",
  "keywords": [
    "slicing",
    "webpack",
    "frontend mentor",
    "frontend",
    "figma",
    "figma to code",
    "design to code"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "slices/*",
    "www"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "gen:slices": "plop"
  },
  "type": "module",
  "devDependencies": {
    "plop": "^4.0.5",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3"
  }
}
